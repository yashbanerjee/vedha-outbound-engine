# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lead_pipeline?schema=public"

# Auth.js secret: generate with `openssl rand -base64 32`
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_URL="http://localhost:3000"

# OpenAI API key for the AI pre-filter (gpt-4o-mini)
OPENAI_API_KEY=""

# Initial admin account created by `pnpm db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin1234"
# Set to "false" to skip demo team/manager/BDE accounts
SEED_DEMO="true"

# Worker tuning
WORKER_CONCURRENCY="3"
WORKER_POLL_MS="3000"
